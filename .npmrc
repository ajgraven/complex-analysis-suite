# pnpm settings. We keep pnpm's strict, non-hoisted node_modules (ADR-0004): it refuses
# phantom/undeclared dependencies, which actively enforces the dependency-layering rule.
#
# engine-strict is left false so the workspace still installs on the current dev machine
# (Node 21) even though the suite targets Node 22 LTS (.nvmrc / engines). Bump the local
# Node to 22 to match the declared engine.
engine-strict=false
