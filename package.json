{
  "name": "quadrature-domain-solver",
  "version": "0.1.0",
  "description": "Browser app for visualizing simply connected quadrature domains and log-weighted quadrature domains (Graven thesis, Caltech 2026).",
  "private": true,
  "scripts": {
    "test": "node app/node-test.js",
    "lint": "eslint app",
    "lint:fix": "eslint app --fix",
    "typecheck": "tsc --allowJs --checkJs --noEmit --target es2022 --module esnext --moduleResolution bundler --skipLibCheck app/primary-solution.js app/primary-solver-worker.js app/qd.mjs",
    "bench": "node app/bench.js",
    "bench:baseline": "node app/bench.js --runs 20 --baseline-out bench-baseline.json",
    "bench:check": "node app/bench.js --runs 20 --baseline bench-baseline.json",
    "version:sync": "node scripts/gen-cache-version.js --write",
    "version:check": "node scripts/gen-cache-version.js --check",
    "serve": "python3 -m http.server --directory app 8000"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "katex": "0.16.11"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajgraven/Quadrature-Domains-Visualization-Tool.git"
  },
  "license": "MIT"
}
