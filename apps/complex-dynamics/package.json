{
  "name": "complex-dynamics",
  "version": "1.0.0",
  "description": "Interactive complex-dynamics visualizer (parameter space + dynamical plane) on a pure WebGL2 engine.",
  "type": "module",
  "license": "MIT",
  "author": "Andrew Graven <andrew@graven.com>",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@cas/core": "workspace:*",
    "@cas/exact": "workspace:*",
    "@cas/expr": "workspace:*",
    "@cas/gpu": "workspace:*",
    "@cas/interchange": "workspace:*",
    "@cas/schwarz": "workspace:*",
    "driver.js": "^1.5.0",
    "gif.js": "^0.2.0",
    "katex": "^0.17.0"
  }
