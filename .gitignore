# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
*.tsbuildinfo

# Vite
.vite/
# Vite writes one of these next to a TS config each time it loads one (apps/*/vite.config.ts).
# They are build scratch, but land in the repo root of the app — so `git add -A` sweeps them in.
*.timestamp-*.mjs

