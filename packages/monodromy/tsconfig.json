{
  // @cas/monodromy is strict TypeScript. SOURCE-exports model (as @cas/ui): no emit — consumers
  // (Vite/Vitest) resolve src/*.ts directly. The base tsconfig provides the DOM libs permDiagram draws with.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "test"]
}
