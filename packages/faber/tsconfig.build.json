{
  // Emit config: compile src/ -> dist/ as ESM JavaScript + declarations. Consumers import the built
  // `dist/` (package.json `exports`) — the Quadrature Domains raw-Node test runner and the app Vite
  // builds. Internal src/ imports carry a `.js` extension so the emitted ESM resolves under Node.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["test", "dist", "node_modules"]
}
