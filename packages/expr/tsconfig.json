{
  // @cas/expr is strict TypeScript, promoted from Complex Dynamics (whose tsconfig rigor it
  // already met). SOURCE-exports model: no emit — consumers (Vite/Vitest) resolve src/*.ts
  // directly, so internal imports stay extensionless. `noEmit` comes from the base.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "test"]
}
