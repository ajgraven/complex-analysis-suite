{
  "name": "@cas/expr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The expression-language compiler: one AST -> JS (evaluate) + GLSL, with derivative / rational / latex passes. Promoted from the Complex Dynamics app (Phase 5). Consumed via SOURCE by the suite's Vite/Vitest bundlers (no bare-Node consumer), so no dist build is needed.",
  "license": "MIT",
  "author": "Andrew Graven <andrew@graven.com>",
  "exports": {
    ".": "./src/index.ts",
    "./ast": "./src/ast.ts",
    "./lexer": "./src/lexer.ts",
    "./parser": "./src/parser.ts",
    "./evaluate": "./src/evaluate.ts",
    "./glsl": "./src/glsl.ts",
    "./derivative": "./src/derivative.ts",
    "./rational": "./src/rational.ts",
    "./latex": "./src/latex.ts",
    "./complexJs": "./src/complexJs.ts",
    "./complex": "./src/complex.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=22"
  }
}
