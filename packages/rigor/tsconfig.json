{
  // @cas/rigor is a STRICT TypeScript package (ADR-0002). Typecheck + editor + Vitest program
  // (src + test, `noEmit` from the base); the emit lives in tsconfig.build.json.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "test"]
}
