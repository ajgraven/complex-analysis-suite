{
  "name": "@cas/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure numeric kernel shared across the complex-analysis suite: complex arithmetic, formal series, root-finding (Durand-Kerner), Newton. Convention-neutral (ADR-0006: no pi / 2pi-i normalization constants).",
  "license": "MIT",
  "author": "Andrew Graven <andrew@graven.com>",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node bench.mjs",
    "lint": "eslint src test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=22"
  }
}
